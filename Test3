-- FE Invisibility Script (Delta / Mobile & PC)
-- Описание: Ломает репликацию для серверов, делая вас невидимым, но оставляет полупрозрачного клона для вас.

local Player = game:GetService("Players").LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()

if not Character:FindFirstChild("HumanoidRootPart") then
    return
end

-- Создаем локальную копию персонажа (видите только вы)
Character.Archivable = true
local Clone = Character:Clone()
Clone.Parent = workspace
Character.Archivable = false

-- Делаем клон полупрозрачным
for _, part in pairs(Clone:GetDescendants()) do
    if part:IsA("BasePart") then
        part.Transparency = 0.5
        part.CanCollide = false
    elseif part:IsA("Decal") then
        part.Transparency = 0.5
    end
end

-- Переключаем камеру и управление на полупрозрачного клона
workspace.CurrentCamera.CameraSubject = Clone:FindFirstChild("Humanoid")
local Controller = require(Player.PlayerScripts:WaitForChild("PlayerModule")):GetControls()

-- Телепортируем настоящий HumanoidRootPart под карту для других игроков, ломая репликацию
local RealHRP = Character:FindFirstChild("HumanoidRootPart")
local RealHumanoid = Character:FindFirstChild("Humanoid")

if RealHRP and RealHumanoid then
    -- Отвязываем анимации и садим оригинал на невидимое сиденье/удаляем соединение
    RealHumanoid:BreakJoints() 
    RealHRP.CFrame = CFrame.new(0, -500, 0) -- Отправка под карту
    RealHRP.Anchored = true
end

-- Привязка управления к клону
task.spawn(function()
    while task.wait() do
        if Clone and Clone:FindFirstChild("HumanoidRootPart") and RealHRP then
            -- Синхронизация позиции (опционально для некоторых видов инвиза)
            -- В классическом FE инвизе вы управляете локальным гуманоидом клона.
        end
    end
end)

print("Скрипт на невидимость успешно запущен!")
