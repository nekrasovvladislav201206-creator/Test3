local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local PlaceId = game.PlaceId
local JobId = game.JobId

local function getServers(cursor)
    local url = "https://roblox.com" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    if cursor and cursor ~= "" then
        url = url .. "&cursor=" .. cursor
    end
    
    local req = (syn and syn.request) or (http and http.request) or request
    if req then
        local response = req({Url = url, Method = "GET"})
        if response and response.StatusCode == 200 then
            return HttpService:JSONDecode(response.Body)
        end
    else
        return HttpService:JSONDecode(game:HttpGet(url))
    end
    return nil
end

local function startHopping()
    ActionButton.Visible = false
    StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
    
    local cursor = ""
    local bestServerId = nil
    local lowestPlayerCount = 999
    local pagesChecked = 0
    local maxPages = 6 -- Сколько страниц API проверять (до 600 серверов)

    while pagesChecked < maxPages do
        pagesChecked = pagesChecked + 1
        StatusLabel.Text = "🔍 Анализ серверов... (Страница " .. pagesChecked .. "/" .. maxPages .. ")"
        
        local success, result = pcall(function() return getServers(cursor) end)
        
        if success and result and result.data then
            for _, server in ipairs(result.data) do
                if server.id ~= JobId and server.playing < server.maxPlayers then
                    -- Если нашли сервер еще пустее, запоминаем его
                    if server.playing < lowestPlayerCount then
                        lowestPlayerCount = server.playing
                        bestServerId = server.id
                    end
                end
            end
            
            -- Если нашли совсем идеальный сервер (0-2 игрока), не ждем и сразу летим
            if lowestPlayerCount <= 2 and bestServerId then
                break
            end

            if result.nextPageCursor then
                cursor = result.nextPageCursor
            else
                break
            end
        else
            break
        end
        task.wait(0.2)
    end
    
    if bestServerId then
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        StatusLabel.Text = "✅ Лучший сервер найден! Игроков там: " .. lowestPlayerCount .. "\nТелепортация..."
        task.wait(1)
        
        local teleportSuccess, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(PlaceId, bestServerId, Players.LocalPlayer)
        end)
        
        if not teleportSuccess then
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusLabel.Text = "❌ Ошибка телепортации. Защита игры блокирует переход."
            ActionButton.Visible = true
        end
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        StatusLabel.Text = "⏹️ Не удалось прочитать список серверов."
        ActionButton.Visible = true
    end
end

ActionButton.MouseButton1Click:Connect(function()
    startHopping()
end)
