local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

local PlaceId = game.PlaceId
local JobId = game.JobId

local function findEmptyServer()
    local url = "https://roblox.com" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local cursor = ""
    
    while true do
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url .. "&cursor=" .. cursor))
        end)
        
        if success and result and result.data then
            for _, server in ipairs(result.data) do
                -- Ищем сервер, где занято минимум мест, и это не наш текущий сервер
                if server.playing < server.maxPlayers and server.id ~= JobId then
                    -- Если нужно найти совсем пустой (где 0-1 человек)
                    if server.playing <= 1 then
                        return server.id
                    end
                end
            end
            
            if result.nextPageCursor then
                cursor = result.nextPageCursor
            else
                break
            end
        else
            break
        end
        task.wait(0.1)
    end
    return nil
end

local targetServer = findEmptyServer()

if targetServer then
    TeleportService:TeleportToPlaceInstance(PlaceId, targetServer, Players.LocalPlayer)
else
    warn("Не удалось найти подходящий пустой сервер.")
end
