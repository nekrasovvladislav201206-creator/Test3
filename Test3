local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

local PlaceId = game.PlaceId
local JobId = game.JobId

-- Функция для безопасного запроса через Delta API
local function getServers(cursor)
    local url = "https://roblox.com" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    if cursor and cursor ~= "" then
        url = url .. "&cursor=" .. cursor
    end
    
    -- Используем request, который поддерживается в Delta
    local req = (syn and syn.request) or (http and http.request) or request
    if req then
        local response = req({
            Url = url,
            Method = "GET"
        })
        if response and response.StatusCode == 200 then
            return HttpService:JSONDecode(response.Body)
        end
    else
        -- Запасной вариант, если request не сработал
        return HttpService:JSONDecode(game:HttpGet(url))
    end
    return nil
end

local function findEmptyServer()
    local cursor = ""
    while true do
        local result = getServers(cursor)
        
        if result and result.data then
            for _, server in ipairs(result.data) do
                -- Ищем сервер, где играет 0, 1 или 2 человека (чтобы точно зайти)
                if server.playing <= 2 and server.id ~= JobId then
                    return server.id
                end
            end
            
            if result.nextPageCursor then
                cursor = result.nextPageCursor
            else
                break
            end
        else
            break
        end
        task.wait(0.5) -- Небольшая задержка, чтобы Delta не вылетела
    end
    return nil
end

print("Поиск пустого сервера...")
local targetServer = findEmptyServer()

if targetServer then
    print("Сервер найден! Телепортация...")
    TeleportService:TeleportToPlaceInstance(PlaceId, targetServer, Players.LocalPlayer)
else
    print("Пустой сервер не найден или API заблокирован.")
end
